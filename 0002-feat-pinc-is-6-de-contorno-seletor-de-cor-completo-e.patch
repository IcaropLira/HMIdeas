diff --git a/src/components/BrushPanel.tsx b/src/components/BrushPanel.tsx
new file mode 100644
index 0000000..1235c07
--- /dev/null
+++ b/src/components/BrushPanel.tsx
@@ -0,0 +1,39 @@
+import { listBrushes, getBrush } from "../core/brushes";
+import { useTool } from "../core/store";
+import { BrushPreview } from "./BrushPreview";
+
+/** Painel de pincéis: grade com pré-visualização + opacidade. */
+export function BrushPanel() {
+  const t = useTool();
+  const brushes = listBrushes();
+  const current = getBrush(t.brush);
+
+  return (
+    <div className="panel" role="dialog" aria-label="Pincéis">
+      <div className="brushes" role="radiogroup" aria-label="Pincel">
+        {brushes.map((b) => (
+          <button
+            key={b.id}
+            role="radio"
+            aria-checked={current.id === b.id}
+            className={current.id === b.id ? "brush on" : "brush"}
+            title={b.hint}
+            onClick={() => {
+              t.setBrush(b.id);
+              t.setTool("pen"); // escolher um pincel é querer desenhar com ele
+            }}
+          >
+            <BrushPreview brush={b} color={t.color} width={t.width} sens={t.pressureSens} taper={t.taper} opacity={t.opacity} />
+            <span>{b.label}</span>
+          </button>
+        ))}
+      </div>
+      <label className="slider">
+        <span>Opacidade</span>
+        <input type="range" min={0.1} max={1} step={0.05} value={t.opacity} onChange={(e) => t.set({ opacity: +e.target.value })} />
+        <output>{Math.round(t.opacity * 100)}%</output>
+      </label>
+      <p className="hint">{current.hint} Espessura, pressão e afilamento ficam na barra e em “Ajustes da caneta”.</p>
+    </div>
+  );
+}
diff --git a/src/components/BrushPreview.tsx b/src/components/BrushPreview.tsx
new file mode 100644
index 0000000..2f2d491
--- /dev/null
+++ b/src/components/BrushPreview.tsx
@@ -0,0 +1,40 @@
+// Pré-visualização de um brush: uma onda com pressão subindo e descendo, desenhada com o MESMO
+// contorno do traço de verdade (strokeOutline), então reflete cor, pressão e afilamento atuais.
+import { useMemo } from "react";
+import { Brush } from "../core/brushes";
+import { InkPoint } from "../core/model";
+import { strokeOutline } from "../core/ink";
+
+export const PREVIEW_W = 120;
+export const PREVIEW_H = 34;
+
+const SAMPLE: InkPoint[] = Array.from({ length: 40 }, (_, i) => {
+  const t = i / 39;
+  return { x: 10 + t * (PREVIEW_W - 20), y: PREVIEW_H / 2 + Math.sin(t * Math.PI * 2) * 7, p: 0.2 + 0.7 * Math.sin(Math.PI * t) };
+});
+
+interface Props {
+  brush: Brush;
+  color: string;
+  /** Espessura escolhida no controle (antes do multiplicador do brush). */
+  width: number;
+  sens: number;
+  taper: number;
+  opacity: number;
+}
+
+export function BrushPreview({ brush, color, width, sens, taper, opacity }: Props) {
+  const d = useMemo(() => {
+    const w = Math.min(width * brush.size, PREVIEW_H * 0.5);
+    const flat = strokeOutline(SAMPLE, { color, width: w, sens, taper, brush: brush.id, opacity }, true);
+    let path = "";
+    for (let i = 0; i < flat.length; i += 2) path += (i ? "L" : "M") + flat[i].toFixed(1) + " " + flat[i + 1].toFixed(1);
+    return flat.length >= 6 ? path + "Z" : "";
+  }, [brush, color, width, sens, taper, opacity]);
+
+  return (
+    <svg className="bprev" viewBox={`0 0 ${PREVIEW_W} ${PREVIEW_H}`} aria-hidden="true">
+      <path d={d} fill={color} opacity={brush.opacity * opacity} style={{ mixBlendMode: brush.blend }} />
+    </svg>
+  );
+}
