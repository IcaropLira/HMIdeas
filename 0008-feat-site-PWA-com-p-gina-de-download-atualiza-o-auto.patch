diff --git a/src/components/UpdateBanner.tsx b/src/components/UpdateBanner.tsx
new file mode 100644
index 0000000..9f2e5a3
--- /dev/null
+++ b/src/components/UpdateBanner.tsx
@@ -0,0 +1,33 @@
+import { dismissUpdate, installUpdate, useUpdate } from "../core/updater";
+
+/** Aviso de nova versão (desktop, Android e site). */
+export function UpdateBanner() {
+  const u = useUpdate();
+  if (u.dismissed || (u.status !== "available" && u.status !== "downloading" && u.status !== "installing")) return null;
+  const busy = u.status !== "available";
+  const label =
+    u.kind === "link" ? "Baixar" : u.kind === "pwa" ? "Recarregar" : "Atualizar";
+  return (
+    <div className="update-banner" role="status" aria-live="polite">
+      <div className="update-text">
+        <strong>{u.version ? `Nova versão ${u.version}` : "Nova versão disponível"}</strong>
+        <span>
+          {u.status === "downloading"
+            ? `Baixando${u.progress != null ? ` ${Math.round(u.progress * 100)}%` : "…"}`
+            : u.status === "installing"
+              ? "Instalando… o app vai reiniciar."
+              : u.kind === "link"
+                ? "Baixe e instale por cima; seus arquivos ficam como estão."
+                : "Seu desenho é guardado automaticamente."}
+        </span>
+        {u.status === "downloading" && <progress className="update-bar" max={1} value={u.progress ?? undefined} />}
+      </div>
+      {!busy && (
+        <>
+          <button className="btn text" onClick={() => void installUpdate()}>{label}</button>
+          <button className="btn text" onClick={dismissUpdate} aria-label="Lembrar depois">Depois</button>
+        </>
+      )}
+    </div>
+  );
+}
diff --git a/src/core/autosave.ts b/src/core/autosave.ts
new file mode 100644
index 0000000..aa5f70c
--- /dev/null
+++ b/src/core/autosave.ts
@@ -0,0 +1,85 @@
+// Cópia automática do documento no navegador (IndexedDB): fechar a aba, falta de energia ou uma atualização do app
+// não perdem o desenho. NÃO é o arquivo do usuário (isso continua sendo "Salvar" → .hiraku); é só uma rede de segurança.
+import { parseDoc, serializeDoc } from "./serialize";
+import { useDoc } from "./store";
+import { useUI } from "./ui";
+
+const DB = "hm-ideas";
+const STORE = "kv";
+const KEY = "autosave";
+
+function open(): Promise<IDBDatabase> {
+  return new Promise((res, rej) => {
+    const r = indexedDB.open(DB, 1);
+    r.onupgradeneeded = () => r.result.createObjectStore(STORE);
+    r.onsuccess = () => res(r.result);
+    r.onerror = () => rej(r.error);
+  });
+}
+
+async function put(text: string): Promise<void> {
+  const db = await open();
+  await new Promise<void>((res, rej) => {
+    const tx = db.transaction(STORE, "readwrite");
+    tx.objectStore(STORE).put(text, KEY);
+    tx.oncomplete = () => res();
+    tx.onerror = () => rej(tx.error);
+  });
+  db.close();
+}
+
+async function get(): Promise<string | null> {
+  const db = await open();
+  const v = await new Promise<string | null>((res, rej) => {
+    const rq = db.transaction(STORE).objectStore(STORE).get(KEY);
+    rq.onsuccess = () => res((rq.result as string | undefined) ?? null);
+    rq.onerror = () => rej(rq.error);
+  });
+  db.close();
+  return v;
+}
+
+/** Restaura a sessão anterior (se houver) e passa a guardar as mudanças. Devolve a função que desliga. */
+export function initAutosave(): () => void {
+  if (typeof indexedDB === "undefined") return () => undefined;
+  let off = false;
+  let timer: ReturnType<typeof setTimeout> | undefined;
+  let unsub: (() => void) | undefined;
+
+  const flush = () => {
+    clearTimeout(timer);
+    void put(serializeDoc(useDoc.getState().doc)).catch(() => undefined);
+  };
+  const onHide = () => { if (document.visibilityState === "hidden") flush(); };
+
+  void (async () => {
+    try {
+      const saved = await get();
+      const s = useDoc.getState();
+      const pristine = s.past.length === 0 && s.doc.pages.every((p) => p.elements.length === 0);
+      if (!off && saved && pristine) {
+        const doc = parseDoc(saved);
+        if (doc.pages.some((p) => p.elements.length > 0)) {
+          s.loadDoc(doc);
+          useUI.getState().showToast("Sua sessão anterior foi restaurada.");
+        }
+      }
+    } catch { /* cópia ilegível: segue com o documento em branco */ }
+    if (off) return;
+    unsub = useDoc.subscribe((s, prev) => {
+      if (s.doc === prev.doc) return;
+      clearTimeout(timer);
+      timer = setTimeout(flush, 1200);
+    });
+    document.addEventListener("visibilitychange", onHide);
+    window.addEventListener("pagehide", flush);
+  })();
+
+  return () => {
+    off = true;
+    clearTimeout(timer);
+    unsub?.();
+    document.removeEventListener("visibilitychange", onHide);
+    window.removeEventListener("pagehide", flush);
+  };
+}
