@@ -0,0 +1,32 @@
+import { describe, expect, it } from "vitest";
+import { createLoaderCache } from "./loaderCache";
+
+describe("cache de carregamento", () => {
+  it("carrega uma vez só, mesmo com pedidos simultâneos", async () => {
+    let calls = 0;
+    const c = createLoaderCache<number>(async () => { calls++; return 7; });
+    const [a, b] = await Promise.all([c.get("x"), c.get("x")]);
+    expect([a, b]).toEqual([7, 7]);
+    expect(calls).toBe(1);
+  });
+  it("peek é síncrono e só vê o que já carregou", async () => {
+    const c = createLoaderCache<string>(async (k) => k.toUpperCase());
+    expect(c.peek("a")).toBeUndefined();
+    await c.get("a");
+    expect(c.peek("a")).toBe("A");
+  });
+  it("falha ou nulo não ficam no cache e podem ser tentados de novo", async () => {
+    let n = 0;
+    const c = createLoaderCache<number>(async () => { n++; if (n === 1) throw new Error("x"); if (n === 2) return null; return 3; });
+    expect(await c.get("k")).toBeNull();
+    expect(await c.get("k")).toBeNull();
+    expect(await c.get("k")).toBe(3);
+    expect(c.peek("k")).toBe(3);
+  });
+  it("clear esquece tudo", async () => {
+    const c = createLoaderCache<number>(async () => 1);
+    await c.get("a");
+    c.clear();
+    expect(c.peek("a")).toBeUndefined();
+  });
+});
diff --git a/src/core/loaderCache.ts b/src/core/loaderCache.ts
new file mode 100644
index 0000000..35a27d1
--- /dev/null
+++ b/src/core/loaderCache.ts
@@ -0,0 +1,26 @@
+// Cache assíncrono por chave (puro, sem DOM/Pixi): carrega cada chave uma única vez.
+/** Cache genérico por chave com deduplicação de cargas em andamento (testável sem Pixi/DOM). */
+export function createLoaderCache<T>(load: (key: string) => Promise<T | null>) {
+  const ready = new Map<string, T>();
+  const pending = new Map<string, Promise<T | null>>();
+  return {
+    /** Valor já carregado (síncrono) ou undefined. */
+    peek: (key: string): T | undefined => ready.get(key),
+    /** Carrega uma vez só, mesmo que vários elementos peçam a mesma imagem ao mesmo tempo. */
+    get(key: string): Promise<T | null> {
+      const hit = ready.get(key);
+      if (hit !== undefined) return Promise.resolve(hit);
+      let p = pending.get(key);
+      if (!p) {
+        p = load(key)
+          .then((v) => { if (v !== null) ready.set(key, v); return v; })
+          .catch(() => null)
+          .finally(() => { pending.delete(key); });
+        pending.set(key, p);
+      }
+      return p;
+    },
+    values: () => Array.from(ready.values()),
+    clear() { ready.clear(); pending.clear(); },
+  };
+}
