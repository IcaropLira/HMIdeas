@@ -0,0 +1,123 @@
+import { useEffect, useMemo, useRef, useState } from "react";
+import { createDoc, HirakuDoc, newId } from "../core/model";
+import { downloadDoc, parseDoc, serializeDoc } from "../core/serialize";
+import { useDoc } from "../core/store";
+
+type Notebook = { id: string; name: string; updatedAt: number; doc: HirakuDoc };
+const DB_NAME = "hm-ideas-notebooks";
+const DB_STORE = "notebooks";
+const ACTIVE = "hm-ideas:notebooks:active";
+function openDb(): Promise<IDBDatabase> {
+  return new Promise((resolve, reject) => {
+    const request = indexedDB.open(DB_NAME, 1);
+    request.onupgradeneeded = () => { if (!request.result.objectStoreNames.contains(DB_STORE)) request.result.createObjectStore(DB_STORE, { keyPath: "id" }); };
+    request.onsuccess = () => resolve(request.result);
+    request.onerror = () => reject(request.error);
+  });
+}
+async function allNotebooks(): Promise<Notebook[]> {
+  const db = await openDb();
+  try { return await new Promise((resolve, reject) => { const r = db.transaction(DB_STORE).objectStore(DB_STORE).getAll(); r.onsuccess = () => resolve((r.result as Notebook[]).filter((n) => n && typeof n.id === "string" && n.doc?.pages)); r.onerror = () => reject(r.error); }); }
+  finally { db.close(); }
+}
+async function saveNotebook(notebook: Notebook): Promise<void> {
+  const db = await openDb();
+  try { await new Promise<void>((resolve, reject) => { const tx = db.transaction(DB_STORE, "readwrite"); tx.objectStore(DB_STORE).put(notebook); tx.oncomplete = () => resolve(); tx.onerror = () => reject(tx.error); }); }
+  finally { db.close(); }
+}
+async function deleteNotebook(id: string): Promise<void> {
+  const db = await openDb();
+  try { await new Promise<void>((resolve, reject) => { const tx = db.transaction(DB_STORE, "readwrite"); tx.objectStore(DB_STORE).delete(id); tx.oncomplete = () => resolve(); tx.onerror = () => reject(tx.error); }); }
+  finally { db.close(); }
+}
+
+export function NotebookManager() {
+  const [open, setOpen] = useState(false);
+  const [items, setItems] = useState<Notebook[]>([]);
+  const itemsRef = useRef<Notebook[]>([]);
+  const [active, setActive] = useState("");
+  const [query, setQuery] = useState("");
+  const updateItems = (next: Notebook[]) => { itemsRef.current = next; setItems(next); };
+
+  useEffect(() => {
+    let cancelled = false;
+    void (async () => {
+      try {
+        let list = await allNotebooks();
+        let id = localStorage.getItem(ACTIVE) || "";
+        if (!list.length) {
+          id = newId();
+          list = [{ id, name: "Meu primeiro caderno", updatedAt: Date.now(), doc: useDoc.getState().doc }];
+          await saveNotebook(list[0]);
+        }
+        if (!list.some((n) => n.id === id)) id = list[0].id;
+        if (cancelled) return;
+        updateItems(list); setActive(id); localStorage.setItem(ACTIVE, id);
+        const selected = list.find((n) => n.id === id);
+        if (selected) useDoc.getState().loadDoc(selected.doc);
+      } catch { /* se o IndexedDB estiver indisponível, o autosave padrão do app continua ativo */ }
+    })();
+    return () => { cancelled = true; };
+  }, []);
+
+  useEffect(() => {
+    if (!active) return;
+    const unsub = useDoc.subscribe((state) => {
+      if (localStorage.getItem(ACTIVE) !== active) return;
+      const current = itemsRef.current.find((n) => n.id === active);
+      if (!current) return;
+      const updated = { ...current, doc: state.doc, updatedAt: Date.now() };
+      updateItems(itemsRef.current.map((n) => n.id === active ? updated : n));
+      void saveNotebook(updated);
+    });
+    return unsub;
+  }, [active]);
+
+  const visible = useMemo(() => items.filter((n) => n.name.toLowerCase().includes(query.toLowerCase())), [items, query]);
+  const persistCurrent = async () => {
+    const current = itemsRef.current.find((n) => n.id === active);
+    if (current) await saveNotebook({ ...current, doc: useDoc.getState().doc, updatedAt: Date.now() });
+  };
+  const create = async () => {
+    await persistCurrent();
+    const id = newId();
+    const notebook: Notebook = { id, name: `Novo caderno ${itemsRef.current.length + 1}`, updatedAt: Date.now(), doc: createDoc() };
+    await saveNotebook(notebook);
+    updateItems([...itemsRef.current, notebook]); setActive(id); localStorage.setItem(ACTIVE, id); useDoc.getState().loadDoc(notebook.doc);
+  };
+  const switchTo = async (n: Notebook) => {
+    if (n.id === active) return;
+    await persistCurrent();
+    setActive(n.id); localStorage.setItem(ACTIVE, n.id); useDoc.getState().loadDoc(n.doc);
+  };
+  const rename = async (n: Notebook) => {
+    const name = window.prompt("Nome do caderno", n.name)?.trim();
+    if (!name) return;
+    const updated = { ...n, name, updatedAt: Date.now() };
+    updateItems(itemsRef.current.map((x) => x.id === n.id ? updated : x)); await saveNotebook(updated);
+  };
+  const duplicate = async (n: Notebook) => {
+    const copy = { ...n, id: newId(), name: `${n.name} (cópia)`, updatedAt: Date.now(), doc: parseDoc(serializeDoc(n.doc)) };
+    await saveNotebook(copy); updateItems([...itemsRef.current, copy]);
+  };
+  const remove = async (n: Notebook) => {
+    if (itemsRef.current.length <= 1) return;
+    if (!window.confirm(`Excluir o caderno “${n.name}”? Esta ação não pode ser desfeita.`)) return;
+    await deleteNotebook(n.id);
+    const next = itemsRef.current.filter((x) => x.id !== n.id); updateItems(next);
+    if (n.id === active) { const fallback = next[0]; setActive(fallback.id); localStorage.setItem(ACTIVE, fallback.id); useDoc.getState().loadDoc(fallback.doc); }
+  };
+  if (!open) return <button className="notebook-launch btn" onClick={() => setOpen(true)} title="Gerenciador de cadernos" aria-label="Gerenciador de cadernos">▤ Cadernos</button>;
+
+  return <div className="notebook-backdrop" onMouseDown={(e) => { if (e.target === e.currentTarget) setOpen(false); }}>
+    <section className="notebook-dialog" role="dialog" aria-modal="true" aria-label="Gerenciador de cadernos">
+      <header><div><strong>Meus cadernos</strong><small>Organize seus estudos, ideias e referências em espaços separados.</small></div><button className="btn" onClick={() => setOpen(false)} aria-label="Fechar">×</button></header>
+      <div className="notebook-tools"><input value={query} onChange={(e) => setQuery(e.target.value)} placeholder="Buscar cadernos…" /><button className="btn primary" onClick={() => void create()}>＋ Novo caderno</button></div>
+      <div className="notebook-list">{visible.map((n) => <article className={`notebook-card ${n.id === active ? "active" : ""}`} key={n.id}>
+        <button className="notebook-open" onClick={() => void switchTo(n)}><span className="notebook-cover">▤</span><span><b>{n.name}</b><small>{n.doc.pages.length} páginas · {n.doc.pages.reduce((a, p) => a + p.elements.length, 0)} elementos</small><small>Modificado em {new Date(n.updatedAt).toLocaleString()}</small></span></button>
+        <div className="notebook-actions"><button className="btn sm" onClick={() => void rename(n)} title="Renomear">✎</button><button className="btn sm" onClick={() => void duplicate(n)} title="Duplicar">⧉</button><button className="btn sm" onClick={() => downloadDoc(n.doc, n.name.replace(/[^\w\- ]/g, "").trim() || "caderno")} title="Exportar .hiraku">↓</button><button className="btn sm danger" disabled={items.length <= 1} onClick={() => void remove(n)} title="Excluir">×</button></div>
+      </article>)}{!visible.length && <p className="notebook-empty">Nenhum caderno encontrado.</p>}</div>
+      <footer>Os cadernos são armazenados localmente no IndexedDB. Exporte arquivos .hiraku para manter uma cópia externa ou transferi-los.</footer>
+    </section>
+  </div>;
+}
