@@ -36,6 +36,77 @@ export function CanvasView() {
     const canvas = canvasRef.current!;
     const renderer = new Renderer();
     const selectCtl = createSelectController(renderer);
+
+    // Anexos da área de transferência e arrastar/soltar: imagens viram conteúdo incorporado no .hiraku;
+    // URLs e arquivos ficam como cartões clicáveis/identificáveis no próprio quadro.
+    const attachmentAt = () => {
+      const r = host.getBoundingClientRect();
+      return screenToWorld(useView.getState().camera, r.width / 2, r.height / 2);
+    };
+    const addAttachment = (patch: Omit<AttachmentElement, "id" | "type" | "x" | "y" | "angle" | "opacity" | "rounded">, w = 280, h = 180) => {
+      const at = attachmentAt();
+      const el: AttachmentElement = { ...patch, id: newId(), type: "attachment", x: at.x - w / 2, y: at.y - h / 2, w, h, angle: 0, opacity: 1, rounded: true };
+      useDoc.getState().addElement(el);
+      useSel.getState().set([el.id]);
+    };
+    const readDataUrl = (file: Blob) => new Promise<string>((resolve, reject) => {
+      const reader = new FileReader(); reader.onload = () => typeof reader.result === "string" ? resolve(reader.result) : reject(new Error("Arquivo inválido"));
+      reader.onerror = () => reject(reader.error ?? new Error("Não foi possível ler o arquivo")); reader.readAsDataURL(file);
+    });
+    const addFile = async (file: File) => {
+      const isImage = file.type.startsWith("image/");
+      // Arquivos muito grandes não são embutidos para evitar documentos gigantes; ainda ganham cartão.
+      const dataUrl = file.size <= 12 * 1024 * 1024 ? await readDataUrl(file).catch(() => undefined) : undefined;
+      if (isImage && dataUrl) {
+        const dims = await new Promise<{w:number;h:number}>((resolve) => {
+          const img = new Image(); img.onload = () => resolve({ w: img.naturalWidth || 640, h: img.naturalHeight || 480 });
+          img.onerror = () => resolve({ w: 640, h: 480 }); img.src = dataUrl;
+        });
+        const scale = Math.min(1, 520 / dims.w, 420 / dims.h);
+        addAttachment({ kind: "image", name: file.name || "Imagem colada", mime: file.type || "image/*", dataUrl }, Math.max(80, dims.w * scale), Math.max(60, dims.h * scale));
+      } else {
+        addAttachment({ kind: "file", name: file.name || "Arquivo anexado", mime: file.type || "application/octet-stream", ...(dataUrl ? { dataUrl } : {}) }, 300, 132);
+      }
+    };
+    const onPaste = (e: ClipboardEvent) => {
+      if (e.defaultPrevented) return;
+      const target = e.target as HTMLElement | null;
+      if (target?.closest("input,textarea,[contenteditable=true]")) return;
+      const items = Array.from(e.clipboardData?.items ?? []);
+      const files = items.map((i) => i.kind === "file" ? i.getAsFile() : null).filter((f): f is File => !!f);
+      if (files.length) { e.preventDefault(); void Promise.all(files.map(addFile)); return; }
+      const text = e.clipboardData?.getData("text/plain")?.trim() ?? "";
+      const html = e.clipboardData?.getData("text/html") ?? "";
+      const imageSrc = html.match(/<img[^>]+src=["']([^"']+)["']/i)?.[1];
+      if (imageSrc && /^https?:/i.test(imageSrc)) {
+        e.preventDefault(); addAttachment({ kind: "link", name: "Imagem da web", mime: "text/uri-list", url: imageSrc }, 320, 120); return;
+      }
+      if (/^https?:\/\//i.test(text)) {
+        e.preventDefault(); let name = text;
+        try { const u = new URL(text); name = /youtube\.com|youtu\.be|vimeo\.com|tiktok\.com/i.test(u.hostname) ? "Vídeo / mídia" : u.hostname.replace(/^www\./, ""); } catch { /* mantém URL original */ }
+        addAttachment({ kind: "link", name, mime: "text/uri-list", url: text }, 340, 142); return;
+      }
+      // Sem conteúdo externo reconhecível, mantém o Ctrl+V interno do HM Ideas.
+      if (useSel.getState().ids.length) { e.preventDefault(); pasteClipboard(); }
+    };
+    const onDrop = (e: DragEvent) => {
+      const files = Array.from(e.dataTransfer?.files ?? []);
+      if (files.length) { e.preventDefault(); void Promise.all(files.map(addFile)); return; }
+      const url = e.dataTransfer?.getData("text/uri-list") || e.dataTransfer?.getData("text/plain");
+      if (url && /^https?:\/\//i.test(url.trim())) { e.preventDefault(); addAttachment({ kind: "link", name: "Link anexado", mime: "text/uri-list", url: url.trim() }, 340, 142); }
+    };
+    const onDragOver = (e: DragEvent) => { if (e.dataTransfer?.types.length) e.preventDefault(); };
+    const onAttachmentOpen = (e: MouseEvent) => {
+      const r = host.getBoundingClientRect();
+      const pt = screenToWorld(useView.getState().camera, e.clientX - r.left, e.clientY - r.top);
+      const page = selectActivePage(useDoc.getState());
+      const el = [...page.elements].reverse().find((item) => item.type === "attachment" && pt.x >= item.x && pt.x <= item.x + item.w && pt.y >= item.y && pt.y <= item.y + item.h);
+      if (el?.type !== "attachment") return;
+      if (el.url) window.open(el.url, "_blank", "noopener,noreferrer");
+      else if (el.dataUrl) { const a = document.createElement("a"); a.href = el.dataUrl; a.download = el.name || "anexo"; a.click(); }
+    };
+    window.addEventListener("paste", onPaste);
+    host.addEventListener("drop", onDrop); host.addEventListener("dragover", onDragOver); host.addEventListener("dblclick", onAttachmentOpen);
     const unsubs: Array<() => void> = [];
     let input: InputController | null = null;
     let disposed = false;
@@ -528,6 +599,8 @@ export function CanvasView() {
     return () => {
       disposed = true;
