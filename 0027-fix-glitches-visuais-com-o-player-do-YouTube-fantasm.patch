diff --git a/src/components/EmbedLayer.tsx b/src/components/EmbedLayer.tsx
index 5d9a7d8..977cad0 100644
--- a/src/components/EmbedLayer.tsx
+++ b/src/components/EmbedLayer.tsx
@@ -1,4 +1,5 @@
-import { useEffect } from "react";
+import { useEffect, useState } from "react";
+import { screenToWorld } from "../core/camera";
 import { AttachmentElement } from "../core/model";
 import { useEmbedView } from "../core/embedView";
 import { clampPage, clampScroll, maxScroll, pageAtScroll, parseYouTube, scrollLayout, youtubeEmbed, youtubeWatch } from "../core/embed";
@@ -51,6 +52,47 @@ export function EmbedLayer() {
     return () => window.removeEventListener("keydown", onKey);
   }, []);
 
+  // Anti-glitch do player (iframe = camada própria do compositor): enquanto a câmera se mexe, ou o vídeo é
+  // arrastado/redimensionado, o iframe fica invisível (a miniatura do Pixi aparece no lugar, já na posição certa)
+  // e volta ~150 ms depois. Isso evita o "fantasma" do quadro anterior.
+  const [moving, setMoving] = useState(false);
+  const [held, setHeld] = useState(false);
+  useEffect(() => {
+    setMoving(true);
+    const t = setTimeout(() => setMoving(false), 150);
+    return () => clearTimeout(t);
+  }, [cam]);
+  useEffect(() => {
+    let release: ReturnType<typeof setTimeout> | undefined;
+    const down = (ev: PointerEvent) => {
+      const id = useEmbedView.getState().playing;
+      if (!id || (ev.target as HTMLElement | null)?.closest?.(".embed-layer button")) return;
+      const el = selectActivePage(useDoc.getState()).elements.find((x) => x.id === id);
+      if (!el) return;
+      const c = useView.getState().camera;
+      const P = screenToWorld(c, ev.clientX, ev.clientY);
+      const m = 16 / c.zoom; // inclui as alças de redimensionar, que ficam um pouco fora do quadro
+      if (P.x >= el.x - m && P.x <= el.x + el.w + m && P.y >= el.y - m && P.y <= el.y + el.h + m) { clearTimeout(release); setHeld(true); }
+    };
+    const up = () => { clearTimeout(release); release = setTimeout(() => setHeld(false), 80); };
+    window.addEventListener("pointerdown", down, true);
+    window.addEventListener("pointerup", up, true);
+    window.addEventListener("pointercancel", up, true);
+    return () => {
+      clearTimeout(release);
+      window.removeEventListener("pointerdown", down, true);
+      window.removeEventListener("pointerup", up, true);
+      window.removeEventListener("pointercancel", up, true);
+    };
+  }, []);
+
+  // Com um player vivo na tela, as sombras grandes das barras viram retângulos pretos no WebView2: desliga-as.
+  const live = !!playing && elements.some((e) => e.id === playing);
+  useEffect(() => {
+    document.documentElement.classList.toggle("embed-live", live);
+    return () => document.documentElement.classList.remove("embed-live");
+  }, [live]);
+
   const vw = typeof window !== "undefined" ? window.innerWidth : 1920;
   const vh = typeof window !== "undefined" ? window.innerHeight : 1080;
   const items = elements.filter((e): e is AttachmentElement => e.type === "attachment" && (e.kind === "video" || e.kind === "pdf"));
@@ -59,10 +101,11 @@ export function EmbedLayer() {
   return (
     <div className="embed-layer">
       {items.map((el) => {
-        const left = el.x * cam.zoom + cam.x, top = el.y * cam.zoom + cam.y;
+        const left = Math.round(el.x * cam.zoom + cam.x), top = Math.round(el.y * cam.zoom + cam.y);
         const w = el.w * cam.zoom, h = el.h * cam.zoom;
         if (left > vw || top > vh || left + w < 0 || top + h < 0) return null; // fora da tela: nada de iframe vivo
-        const box = { left, top, width: w, height: h };
+        // posiciona por transform (não relayouta o iframe a cada pan); o tamanho do iframe só muda no zoom
+        const box = { width: w, height: h, transform: `translate3d(${left}px, ${top}px, 0)` };
         if (el.kind === "pdf") {
           if (!sel.includes(el.id)) return null;
           const count = Math.max(1, el.pages ?? 1);
@@ -90,14 +133,17 @@ export function EmbedLayer() {
         if (!yt) return null;
         if (playing === el.id) {
           return (
-            <div key={el.id} className="embed-box" style={box}>
-              <iframe
-                src={youtubeEmbed(yt)}
-                title={el.title}
-                allow="autoplay; encrypted-media; picture-in-picture; fullscreen"
-                allowFullScreen
-                referrerPolicy="strict-origin-when-cross-origin"
-              />
+            <div key={el.id} className={`embed-box${moving || held ? " embed-hold" : ""}`} style={box}>
+              <div className="embed-frame" style={{ width: el.w, height: el.h, transform: `scale(${cam.zoom})` }}>
+                <iframe
+                  src={youtubeEmbed(yt)}
+                  title={el.title}
+                  allow="autoplay; encrypted-media; picture-in-picture; fullscreen"
+                  allowFullScreen
+                  referrerPolicy="strict-origin-when-cross-origin"
+                  style={{ pointerEvents: sel.includes(el.id) ? "auto" : "none" }}
+                />
+              </div>
               <div className="embed-bar">
                 <button onClick={() => void openExternal(youtubeWatch(yt))} title="Abrir no navegador">Abrir no navegador ↗</button>
                 <button onClick={() => play(null)} title="Voltar à miniatura">Fechar</button>
diff --git a/src/styles.css b/src/styles.css
index 2e43c82..ef33c52 100644
--- a/src/styles.css
+++ b/src/styles.css
@@ -620,8 +620,14 @@ a.chip { display: inline-flex; align-items: center; text-decoration: none; }
 
 /* Incorporados (vídeo do YouTube, PDF): camada DOM sobre o canvas */
 .embed-layer { position: absolute; inset: 0; pointer-events: none; overflow: hidden; }
-.embed-box { position: absolute; pointer-events: none; }
-.embed-box iframe { width: 100%; height: 100%; border: 0; border-radius: 6px; background: #000; pointer-events: auto; }
+.embed-box { position: absolute; left: 0; top: 0; pointer-events: none; will-change: transform; }
+/* o iframe tem sempre o tamanho do elemento no mundo; o zoom é um scale (sem relayout do player a cada passo) */
+.embed-frame { transform-origin: 0 0; contain: layout paint size; }
+.embed-box iframe { display: block; width: 100%; height: 100%; border: 0; border-radius: 6px; background: #000; }
+/* câmera em movimento / vídeo sendo arrastado: esconde o iframe (a miniatura do canvas fica no lugar) */
+.embed-hold iframe, .embed-hold .embed-bar { visibility: hidden; }
+/* player vivo: sombras grandes sobre o iframe viram blocos pretos no WebView2 */
+:root.embed-live { --shadow: none; }
 .embed-bar { position: absolute; right: 0; top: -34px; display: flex; gap: 6px; pointer-events: auto; }
 .embed-bar button, .embed-nav button {
   font: inherit; font-size: 12px; padding: 5px 10px; border-radius: 8px; cursor: pointer;
