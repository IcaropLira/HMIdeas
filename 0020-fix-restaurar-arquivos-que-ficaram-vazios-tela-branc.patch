+
+        {bottomIds.length > 0 && (
+          <div className="toolbar" role="toolbar" aria-label="Ferramentas" onClickCapture={noteAnchor("bottom")}>
+            {renderBlocks("bottom")}
+          </div>
+        )}
+      </div>
+
+      {floatIds.length > 0 && (
+        <div className="float-layer" ref={floatsRef}>
+          {floatIds.map((id) => {
+            const f = layout.floats[id] ?? defaultFloat(layout);
+            return (
+              <div
+                key={id}
+                data-fbar={id}
+                className={f.vertical ? "toolbar fbar vbar" : "toolbar fbar"}
+                style={{ left: f.x, top: f.y }}
+                role="toolbar"
+                aria-orientation={f.vertical ? "vertical" : "horizontal"}
+                aria-label={`Barra flutuante: ${BLOCKS.find((b) => b.id === id)?.label ?? id}`}
+                onClickCapture={noteAnchor("float")}
+              >
+                {renderBlock(id)}
+              </div>
+            );
+          })}
+        </div>
+      )}
+
+      {panel && panelPosition && (
+        <div className="panel-float" ref={floatRef} style={{ left: panelPosition.x, top: panelPosition.y }}>
+          {panelsNode}
+        </div>
+      )}
+
+      <LayoutSettings />
+    </>
+  );
+}
diff --git a/src/components/blockDrag.test.ts b/src/components/blockDrag.test.ts
index e69de29..e3dbfca 100644
--- a/src/components/blockDrag.test.ts
+++ b/src/components/blockDrag.test.ts
@@ -0,0 +1,165 @@
+// O gesto de arrastar um bloco pela alça, simulado sem navegador: window/document falsos e eventos de ponteiro.
+import type { PointerEvent as ReactPointerEvent } from "react";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { DEFAULT_LAYOUT, useLayout } from "../core/layout";
+import { rotateBlock, startBlockDrag } from "./BlockHandle";
+
+const rect = (left: number, top: number, width: number, height: number) => ({ left, top, width, height, right: left + width, bottom: top + height, x: left, y: top });
+
+let win: EventTarget & { innerWidth: number; innerHeight: number };
+const body = { classList: { add: vi.fn(), remove: vi.fn() } };
+let fbarSize = { w: 264, h: 58 };
+
+beforeEach(() => {
+  win = Object.assign(new EventTarget(), { innerWidth: 1000, innerHeight: 700 });
+  body.classList.add.mockClear();
+  body.classList.remove.mockClear();
+  fbarSize = { w: 264, h: 58 };
+  vi.stubGlobal("window", win);
+  vi.stubGlobal("document", {
+    body,
+    querySelector: (sel: string) => (sel.startsWith("[data-fbar") ? { getBoundingClientRect: () => rect(0, 0, fbarSize.w, fbarSize.h) } : null),
+  });
+  useLayout.setState({ layout: DEFAULT_LAYOUT });
+});
+afterEach(() => vi.unstubAllGlobals());
+
+/** Clique na alça de um bloco que está na barra de baixo em (300, 620), 250×44; ponteiro a (17, 27) do canto. */
+function press(opts: { pointerType?: string; button?: number; pointerId?: number } = {}) {
+  const block = { getBoundingClientRect: () => rect(300, 620, 250, 44) };
+  const e = {
+    pointerType: opts.pointerType ?? "mouse",
+    button: opts.button ?? 0,
+    pointerId: opts.pointerId ?? 1,
+    clientX: 317,
+    clientY: 647,
+    preventDefault: vi.fn(),
+    currentTarget: { closest: () => block },
+  };
+  startBlockDrag(e as unknown as ReactPointerEvent<HTMLElement>, "tools");
+  return e;
+}
+const fire = (type: "pointermove" | "pointerup" | "pointercancel", x: number, y: number, pointerId = 1) =>
+  win.dispatchEvent(Object.assign(new Event(type), { clientX: x, clientY: y, pointerId }));
+const state = () => useLayout.getState().layout;
+
+describe("arrastar bloco pela alça", () => {
+  it("um toque sem mover não muda nada", () => {
+    const e = press();
+    expect(e.preventDefault).toHaveBeenCalled();
+    fire("pointerup", 317, 647);
+    expect(state()).toBe(DEFAULT_LAYOUT);
+    expect(body.classList.remove).toHaveBeenCalledWith("dragging-ui");
+  });
+
+  it("tremor de poucos pixels não começa o arraste", () => {
+    press();
+    fire("pointermove", 319, 648);
+    expect(state().side.tools).toBe("bottom");
+    fire("pointerup", 319, 648);
+    expect(state()).toBe(DEFAULT_LAYOUT);
+  });
+
+  it("ao mover, o bloco vira flutuante e acompanha o ponteiro mantendo o ponto que foi segurado", () => {
+    press();
+    fire("pointermove", 500, 300);
+    expect(state().side.tools).toBe("float");
+    // início = canto do bloco − margem da barra (7); deslocamento do ponteiro = (317−293, 647−613) = (24, 34)
+    expect(state().floats.tools).toMatchObject({ x: 500 - 24, y: 300 - 34, vertical: false });
+    fire("pointerup", 500, 300);
+    expect(state().floats.tools).toMatchObject({ x: 476, y: 266, vertical: false });
+    expect(state().order.length).toBe(DEFAULT_LAYOUT.order.length);
+    expect(body.classList.add).toHaveBeenCalledWith("dragging-ui");
+  });
+
+  it("soltar perto da borda esquerda gruda nela e vira vertical", () => {
+    press();
+    // o ímã mede a borda do BLOCO, não o ponteiro: ponteiro em x=40 deixa o bloco em x=16, a 8px da borda
+    fire("pointermove", 40, 300);
+    fire("pointerup", 40, 300);
+    expect(state().floats.tools).toMatchObject({ x: 8, vertical: true });
+  });
+
+  it("longe da borda (fora do alcance do ímã) fica onde foi solto", () => {
+    press();
+    fire("pointermove", 90, 300); // bloco em x=66, a 58px da borda
+    fire("pointerup", 90, 300);
+    expect(state().floats.tools).toMatchObject({ x: 66, vertical: false });
+  });
+
+  it("soltar perto da borda de baixo gruda e continua horizontal", () => {
+    press();
+    fire("pointermove", 500, 690);
+    fire("pointerup", 500, 690);
+    expect(state().floats.tools).toMatchObject({ y: 700 - 58 - 8, vertical: false });
+  });
+
+  it("arrastar para fora da janela nunca deixa o bloco fora dela", () => {
+    press();
+    fire("pointermove", 9000, 9000);
+    expect(state().floats.tools!.x + fbarSize.w).toBeLessThanOrEqual(1000 - 8);
+    expect(state().floats.tools!.y + fbarSize.h).toBeLessThanOrEqual(700 - 8);
+    fire("pointermove", -9000, -9000);
+    expect(state().floats.tools!.x).toBeGreaterThanOrEqual(8);
+    expect(state().floats.tools!.y).toBeGreaterThanOrEqual(8);
+    fire("pointerup", -9000, -9000);
+    expect(state().floats.tools!.x).toBeGreaterThanOrEqual(8);
+  });
+
+  it("se o sistema cancela o gesto, o bloco volta para onde estava", () => {
+    press();
+    fire("pointermove", 500, 300);
+    expect(state().side.tools).toBe("float");
+    fire("pointercancel", 500, 300);
+    expect(state().side.tools).toBe("bottom");
+    expect(state().floats.tools).toBeUndefined();
+  });
+
+  it("botão direito do mouse não arrasta", () => {
+    press({ button: 2 });
+    fire("pointermove", 500, 300);
+    expect(state()).toBe(DEFAULT_LAYOUT);
+    expect(body.classList.add).not.toHaveBeenCalled();
+  });
+
+  it("outro dedo/ponteiro durante o gesto é ignorado", () => {
+    press({ pointerType: "touch", pointerId: 7 });
+    fire("pointermove", 500, 300, 9);
+    expect(state().side.tools).toBe("bottom");
+    fire("pointermove", 500, 300, 7);
+    expect(state().side.tools).toBe("float");
+    fire("pointerup", 500, 300, 9); // não é o dedo do arraste: não termina
+    expect(body.classList.remove).not.toHaveBeenCalled();
+    fire("pointerup", 500, 300, 7);
+    expect(body.classList.remove).toHaveBeenCalledWith("dragging-ui");
+  });
+
+  it("depois de soltar, movimentos soltos não mexem mais no bloco", () => {
+    press();
+    fire("pointermove", 500, 300);
+    fire("pointerup", 500, 300);
+    const parado = state().floats.tools;
+    fire("pointermove", 100, 100);
+    expect(state().floats.tools).toEqual(parado);
+  });
+
+  it("reabrir um bloco que já flutua continua de onde ele estava", () => {
+    useLayout.getState().setFloat("tools", { x: 200, y: 100, vertical: false }, false);
+    press();
+    fire("pointermove", 400, 400);
+    // deslocamento = ponteiro (317,647) − posição guardada (200,100) = (117, 547): x = 400−117, e y = 400−547 sai da tela e é limitado a 8
+    expect(state().floats.tools).toMatchObject({ x: 283, y: 8 });
+  });
+});
+
+describe("girar bloco flutuante", () => {
+  it("alterna horizontal ↔ vertical só se o bloco flutua", () => {
+    rotateBlock("tools");
+    expect(state()).toBe(DEFAULT_LAYOUT);
+    useLayout.getState().setFloat("tools", { x: 50, y: 60, vertical: false }, false);
+    rotateBlock("tools");
+    expect(state().floats.tools).toEqual({ x: 50, y: 60, vertical: true });
+    rotateBlock("tools");
+    expect(state().floats.tools!.vertical).toBe(false);
+  });
+});
diff --git a/src/components/layout.test.tsx b/src/components/layout.test.tsx
index e69de29..8f0f8df 100644
--- a/src/components/layout.test.tsx
+++ b/src/components/layout.test.tsx
@@ -0,0 +1,157 @@
+// Fumaça das barras personalizáveis: onde cada botão cai no layout padrão e o menu de configurações.
+// Renderização no servidor (sem DOM): o zustand lê o estado inicial, então aqui valem os padrões.
+import { renderToString } from "react-dom/server";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { BLOCKS, DEFAULT_LAYOUT, Layout, placeBlock } from "../core/layout";
+import { LayoutSettingsView } from "./LayoutSettings";
+import { Toolbar } from "./Toolbar";
+
+// No servidor o zustand ignora setState e lê sempre o estado INICIAL; por isso o hook do layout é trocado por um que lê daqui.
+const mock = vi.hoisted(() => ({ layout: undefined as Layout | undefined }));
+vi.mock("../core/layout", async (importOriginal) => {
+  const real = await importOriginal<typeof import("../core/layout")>();
+  const useLayout = (sel: (s: unknown) => unknown) => sel({ layout: mock.layout ?? real.DEFAULT_LAYOUT, setSide() {}, move() {}, reset() {} });
+  return { ...real, useLayout };
+});
+
+afterEach(() => { mock.layout = undefined; });
+
+const at = (html: string, needle: string) => {
+  const i = html.indexOf(needle);
+  expect(i, `não achei ${needle}`).toBeGreaterThanOrEqual(0);
+  return i;
+};
+
+describe("Toolbar em blocos", () => {
+  it("no padrão: ferramentas e formas embaixo, mapa/papel na esquerda, pincéis/cor/espessura na direita", () => {
+    const html = renderToString(<Toolbar />);
+    const left = at(html, "rail-left");
+    const right = at(html, "rail-right");
+    const dock = at(html, 'class="dock"');
+    expect(left).toBeLessThan(right);
+    expect(right).toBeLessThan(dock);
+    // esquerda: mapa mental e papel
+    expect(at(html, 'aria-label="Mapa mental"')).toBeGreaterThan(left);
+    expect(at(html, 'aria-label="Mapa mental"')).toBeLessThan(right);
+    expect(at(html, 'aria-label="Papel"')).toBeLessThan(right);
+    // direita: pincéis, cores e espessura
+    expect(at(html, 'aria-label="Pincéis"')).toBeGreaterThan(right);
+    expect(at(html, 'aria-label="Pincéis"')).toBeLessThan(dock);
+    expect(at(html, 'aria-label="Mais cores"')).toBeLessThan(dock);
+    expect(at(html, "Espessura do traço")).toBeLessThan(dock);
+    // embaixo: ferramentas, formas e histórico
+    for (const nome of ["Selecionar", "Caneta", "Borracha", "Texto", "Mover tela", "Retângulo", "Seta", "Desfazer", "Refazer"]) {
+      expect(at(html, `aria-label="${nome}"`), nome).toBeGreaterThan(dock);
+    }
+  });
+
+  it("bloco oculto some da tela; lado vazio não gera barra", () => {
+    mock.layout = placeBlock(placeBlock(placeBlock(DEFAULT_LAYOUT, "brush", "hidden"), "colors", "hidden"), "size", "hidden");
+    const html = renderToString(<Toolbar />);
+    expect(html).not.toContain("rail-right");
+    expect(html).not.toContain('aria-label="Pincéis"');
+    expect(html).not.toContain('aria-label="Mais cores"');
+  });
+
+  it("mover um bloco para a esquerda coloca os botões dele na barra da esquerda", () => {
+    mock.layout = placeBlock(DEFAULT_LAYOUT, "history", "left");
+    const html = renderToString(<Toolbar />);
+    expect(at(html, 'aria-label="Desfazer"')).toBeLessThan(at(html, "rail-right"));
+  });
+
+  it("a engrenagem de configurações sempre existe, mesmo com tudo oculto", () => {
+    let l = DEFAULT_LAYOUT;
+    for (const b of BLOCKS) l = placeBlock(l, b.id, "hidden");
+    mock.layout = l;
+    const html = renderToString(<Toolbar />);
+    expect(html).toContain('aria-label="Configurações"');
+    expect(html).not.toContain("rail-left");
+  });
+});
+
+describe("blocos flutuantes e alças", () => {
+  const countGrips = (html: string) => (html.match(/class="grip"/g) ?? []).length;
+
+  it("cada bloco visível tem uma alça de 6 pontos (2 colunas × 3 linhas)", () => {
+    const html = renderToString(<Toolbar />);
+    expect(countGrips(html)).toBe(BLOCKS.length);
+    expect((html.match(/class="grip"[^>]*>((?:<i><\/i>){6})<\/div>/g) ?? []).length).toBe(BLOCKS.length);
+  });
+
+  it("travar as posições esconde todas as alças", () => {
+    mock.layout = { ...DEFAULT_LAYOUT, locked: true };
+    expect(countGrips(renderToString(<Toolbar />))).toBe(0);
+  });
+
+  it("bloco oculto não tem alça", () => {
+    mock.layout = placeBlock(DEFAULT_LAYOUT, "colors", "hidden");
+    expect(countGrips(renderToString(<Toolbar />))).toBe(BLOCKS.length - 1);
+  });
+
+  it("bloco flutuante vira barra solta na posição guardada, com os botões dele", () => {
+    mock.layout = placeBlock(DEFAULT_LAYOUT, "colors", "float", { x: 320, y: 111, vertical: false });
+    const html = renderToString(<Toolbar />);
+    expect(html).toContain('class="float-layer"');
+    expect(html).toMatch(/data-fbar="colors" class="toolbar fbar"[^>]*style="left:320px;top:111px"/);
+    expect(html.indexOf('aria-label="Mais cores"')).toBeGreaterThan(html.indexOf('class="float-layer"'));
+    expect(html).toContain("Barra flutuante: Cores");
+  });
+
+  it("bloco flutuante girado usa a barra vertical", () => {
+    mock.layout = placeBlock(DEFAULT_LAYOUT, "history", "float", { x: 20, y: 200, vertical: true });
+    expect(renderToString(<Toolbar />)).toMatch(/data-fbar="history" class="toolbar fbar vbar"/);
+  });
+
+  it("sem blocos flutuantes não existe a camada", () => {
+    expect(renderToString(<Toolbar />)).not.toContain("float-layer");
+  });
+
+  it("os botões do bloco flutuante saem da barra de origem (sem duplicar)", () => {
+    mock.layout = placeBlock(DEFAULT_LAYOUT, "history", "float", { x: 20, y: 200, vertical: false });
+    const html = renderToString(<Toolbar />);
+    expect((html.match(/aria-label="Desfazer"/g) ?? []).length).toBe(1);
+  });
+});
+
+describe("LayoutSettingsView", () => {
+  const view = (layout = DEFAULT_LAYOUT) =>
+    renderToString(<LayoutSettingsView layout={layout} onSide={vi.fn()} onMove={vi.fn()} onRotate={vi.fn()} onLocked={vi.fn()} onReset={vi.fn()} onClose={vi.fn()} />);
+
+  it("lista todos os blocos, cada um com as quatro posições, e o botão de restaurar", () => {
+    const html = view();
+    for (const b of BLOCKS) expect(html).toContain(b.label);
+    for (const lado of ["Embaixo", "Esquerda", "Direita", "Flutuante", "Oculto"]) expect((html.match(new RegExp(`>${lado}<`, "g")) ?? []).length).toBe(BLOCKS.length);
+    expect(html).toContain("Restaurar padrão");
+    expect(html).toContain('role="dialog"');
+  });
+
+  it("marca a posição atual de cada bloco", () => {
+    const html = view(placeBlock(DEFAULT_LAYOUT, "colors", "hidden"));
+    expect(html).toMatch(/aria-label="Onde fica: Cores"[^>]*>(?:(?!<\/div>).)*aria-checked="true" class="chip on"[^>]*>Oculto</s);
+  });
+
+  it("não deixa mover para cima o primeiro bloco de um lado, nem bloco oculto", () => {
+    const html = view(placeBlock(DEFAULT_LAYOUT, "colors", "hidden"));
+    expect(html).toMatch(/disabled=""[^>]*aria-label="Mover Ferramentas para antes"/);
+    expect(html).toMatch(/disabled=""[^>]*aria-label="Mover Cores para antes"/);
+    expect(html).toMatch(/disabled=""[^>]*aria-label="Mover Cores para depois"/);
+  });
+});
+
+describe("LayoutSettingsView: flutuante e trava", () => {
+  const view = (layout: Layout) =>
+    renderToString(<LayoutSettingsView layout={layout} onSide={vi.fn()} onMove={vi.fn()} onRotate={vi.fn()} onLocked={vi.fn()} onReset={vi.fn()} onClose={vi.fn()} />);
+
+  it("mostra 'Girar' só para os blocos que flutuam", () => {
+    expect(view(DEFAULT_LAYOUT)).not.toContain("Girar ");
+    const html = view(placeBlock(DEFAULT_LAYOUT, "colors", "float", { x: 10, y: 10, vertical: false }));
+    expect(html).toContain('aria-label="Girar Cores"');
+    expect((html.match(/aria-label="Girar /g) ?? []).length).toBe(1);
+  });
+
+  it("o botão de travar reflete o estado", () => {
+    expect(view(DEFAULT_LAYOUT)).toMatch(/aria-pressed="false"[^>]*>Travar posições</);
+    expect(view({ ...DEFAULT_LAYOUT, locked: true })).toMatch(/aria-pressed="true"[^>]*>Posições travadas</);
+  });
+});
+
diff --git a/src/core/layout.test.ts b/src/core/layout.test.ts
index e69de29..214a7f9 100644
--- a/src/core/layout.test.ts
+++ b/src/core/layout.test.ts
@@ -0,0 +1,216 @@
+import { describe, expect, it } from "vitest";
+import { BLOCKS, DEFAULT_LAYOUT, LAYOUT_KEY, blocksOn, clampPosition, loadLayout, moveBlock, normalizeLayout, placeBlock, saveLayout, snapPosition } from "./layout";
+
+const memory = () => {
+  const m = new Map<string, string>();
+  return { getItem: (k: string) => m.get(k) ?? null, setItem: (k: string, v: string) => void m.set(k, v), removeItem: (k: string) => void m.delete(k) };
+};
+
+describe("layout das barras", () => {
+  it("o padrão tem só o essencial embaixo, cor/espessura/pincéis na direita e o resto na esquerda", () => {
+    expect(blocksOn(DEFAULT_LAYOUT, "bottom")).toEqual(["tools", "shapes", "history"]);
+    expect(blocksOn(DEFAULT_LAYOUT, "right")).toEqual(["brush", "colors", "size"]);
+    expect(blocksOn(DEFAULT_LAYOUT, "left")).toEqual(["map", "page"]);
+    expect(blocksOn(DEFAULT_LAYOUT, "hidden")).toEqual([]);
+  });
+
+  it("todo bloco tem nome e aparece uma única vez na ordem", () => {
+    expect(new Set(DEFAULT_LAYOUT.order).size).toBe(BLOCKS.length);
+    for (const b of BLOCKS) expect(b.label.length).toBeGreaterThan(0);
+  });
+
+  it("placeBlock leva o bloco para o fim do outro lado, sem mexer no resto", () => {
+    const l = placeBlock(DEFAULT_LAYOUT, "tools", "right");
+    expect(blocksOn(l, "right")).toEqual(["brush", "colors", "size", "tools"]);
+    expect(blocksOn(l, "bottom")).toEqual(["shapes", "history"]);
+    expect(placeBlock(DEFAULT_LAYOUT, "tools", "bottom")).toBe(DEFAULT_LAYOUT); // nada a fazer
+  });
+
+  it("placeBlock para um lado vazio funciona (e oculto tira da tela)", () => {
+    const l = placeBlock(DEFAULT_LAYOUT, "colors", "hidden");
+    expect(blocksOn(l, "hidden")).toEqual(["colors"]);
+    expect(blocksOn(l, "right")).toEqual(["brush", "size"]);
+  });
+
+  it("moveBlock troca com o vizinho do MESMO lado e para nas pontas", () => {
+    expect(blocksOn(moveBlock(DEFAULT_LAYOUT, "colors", -1), "right")).toEqual(["colors", "brush", "size"]);
+    expect(blocksOn(moveBlock(DEFAULT_LAYOUT, "colors", 1), "right")).toEqual(["brush", "size", "colors"]);
+    expect(moveBlock(DEFAULT_LAYOUT, "tools", -1)).toBe(DEFAULT_LAYOUT);
+    expect(moveBlock(DEFAULT_LAYOUT, "history", 1)).toBe(DEFAULT_LAYOUT);
+  });
+
+  it("não muda o layout original (imutável)", () => {
+    const before = JSON.stringify(DEFAULT_LAYOUT);
+    placeBlock(DEFAULT_LAYOUT, "tools", "left");
+    moveBlock(DEFAULT_LAYOUT, "colors", -1);
+    expect(JSON.stringify(DEFAULT_LAYOUT)).toBe(before);
+  });
+});
+
+describe("normalizeLayout / persistência", () => {
+  it("lixo ou vazio vira o padrão", () => {
+    expect(normalizeLayout(null)).toEqual(DEFAULT_LAYOUT);
+    expect(normalizeLayout("oi")).toEqual(DEFAULT_LAYOUT);
+    expect(normalizeLayout({ order: 3, side: [] })).toEqual(DEFAULT_LAYOUT);
+  });
+
+  it("descarta ids e lados inválidos, tira repetidos e devolve os blocos que faltam", () => {
+    const l = normalizeLayout({ order: ["colors", "colors", "fantasma", "tools"], side: { colors: "left", tools: "cima", fantasma: "left" } });
+    expect(l.order.slice(0, 2)).toEqual(["colors", "tools"]);
+    expect(new Set(l.order).size).toBe(BLOCKS.length);
+    expect(l.side.colors).toBe("left");
+    expect(l.side.tools).toBe("bottom"); // lado inválido volta ao padrão
+    expect("fantasma" in l.side).toBe(false);
+  });
+
+  it("salva e carrega; JSON quebrado ou storage ausente caem no padrão sem lançar erro", () => {
+    const s = memory();
+    const l = placeBlock(DEFAULT_LAYOUT, "tools", "left");
+    saveLayout(l, s);
+    expect(loadLayout(s)).toEqual(l);
+    s.setItem(LAYOUT_KEY, "{quebrado");
+    expect(loadLayout(s)).toEqual(DEFAULT_LAYOUT);
+    expect(loadLayout(null)).toEqual(DEFAULT_LAYOUT);
+    expect(() => saveLayout(l, null)).not.toThrow();
+    const cheio = { ...memory(), setItem: () => { throw new Error("cota"); } };
+    expect(() => saveLayout(l, cheio)).not.toThrow();
+  });
+});
+
+describe("blocos flutuantes", () => {
+  it("placeBlock para 'float' guarda a posição pedida; sem posição usa uma padrão escalonada", () => {
+    const a = placeBlock(DEFAULT_LAYOUT, "tools", "float", { x: 200, y: 90, vertical: true });
+    expect(a.side.tools).toBe("float");
+    expect(a.floats.tools).toEqual({ x: 200, y: 90, vertical: true });
+    expect(blocksOn(a, "bottom")).toEqual(["shapes", "history"]);
+    const b = placeBlock(a, "shapes", "float");
+    expect(b.floats.shapes).toBeDefined();
+    expect(b.floats.shapes).not.toEqual(b.floats.tools); // não empilha um sobre o outro
+  });
+
+  it("mover um bloco que já flutua só muda a posição (e não mexe na ordem)", () => {
+    const a = placeBlock(DEFAULT_LAYOUT, "tools", "float", { x: 10, y: 10, vertical: false });
+    const b = placeBlock(a, "tools", "float", { x: 300, y: 50, vertical: true });
+    expect(b.floats.tools).toEqual({ x: 300, y: 50, vertical: true });
+    expect(b.order).toEqual(a.order);
+  });
+
+  it("sair do modo flutuante apaga a posição guardada", () => {
+    const a = placeBlock(DEFAULT_LAYOUT, "tools", "float", { x: 10, y: 10, vertical: false });
+    const b = placeBlock(a, "tools", "bottom");
+    expect(b.floats.tools).toBeUndefined();
+    expect(b.side.tools).toBe("bottom");
+  });
+
+  it("layout da versão 1 (sem floats/locked) continua valendo", () => {
+    const v1 = { version: 1, order: DEFAULT_LAYOUT.order, side: { ...DEFAULT_LAYOUT.side, colors: "left" } };
+    const l = normalizeLayout(v1);
+    expect(l.version).toBe(2);
+    expect(l.side.colors).toBe("left");
+    expect(l.floats).toEqual({});
+    expect(l.locked).toBe(false);
+  });
+
+  it("flutuante sem posição válida volta ao lado padrão; posição inválida é descartada", () => {
+    const l = normalizeLayout({ side: { tools: "float", colors: "float" }, floats: { colors: { x: "a", y: 3, vertical: true }, tools: { x: 5, y: 6, vertical: false } } });
+    expect(l.side.tools).toBe("float");
+    expect(l.floats.tools).toEqual({ x: 5, y: 6, vertical: false });
+    expect(l.side.colors).toBe("right"); // padrão do bloco
+    expect(l.floats.colors).toBeUndefined();
+    expect(normalizeLayout({ side: { tools: "float" }, floats: { tools: { x: Infinity, y: 1, vertical: false } } }).side.tools).toBe("bottom");
+  });
+
+  it("'locked' só vale se for exatamente true", () => {
+    expect(normalizeLayout({ locked: true }).locked).toBe(true);
+    expect(normalizeLayout({ locked: "sim" }).locked).toBe(false);
+  });
+
+  it("salva e recarrega posição e trava", () => {
+    const s = memory();
+    const l = { ...placeBlock(DEFAULT_LAYOUT, "colors", "float", { x: 33, y: 44, vertical: true }), locked: true };
+    saveLayout(l, s);
+    expect(loadLayout(s)).toEqual(l);
+  });
+});
+
+describe("clampPosition (nunca sai da tela)", () => {
+  const vp = { w: 1000, h: 700 };
+  const size = { w: 300, h: 60 };
+
+  it("mantém o que já está dentro", () => {
+    expect(clampPosition({ x: 100, y: 100 }, size, vp)).toEqual({ x: 100, y: 100 });
+  });
+
+  it("puxa de volta o que passou de qualquer borda, respeitando a margem", () => {
+    expect(clampPosition({ x: -50, y: -9 }, size, vp)).toEqual({ x: 8, y: 8 });
+    expect(clampPosition({ x: 900, y: 690 }, size, vp)).toEqual({ x: 1000 - 300 - 8, y: 700 - 60 - 8 });
+  });
+
+  it("bloco maior que a janela fica colado no canto de cima/esquerda (e continua alcançável)", () => {
+    expect(clampPosition({ x: 400, y: 400 }, { w: 2000, h: 2000 }, vp)).toEqual({ x: 8, y: 8 });
+  });
+
+  it("janela encolhida (rotação, redimensionar) reposiciona o que ficou para fora", () => {
+    expect(clampPosition({ x: 700, y: 500 }, size, { w: 500, h: 400 })).toEqual({ x: 500 - 300 - 8, y: 400 - 60 - 8 });
+  });
+});
+
+describe("snapPosition (ímã nas bordas)", () => {
+  const vp = { w: 1000, h: 700 };
+  const horiz = { w: 300, h: 60 };
+  const vert = { w: 60, h: 300 };
+
+  it("longe de tudo: não gruda nem muda a orientação", () => {
+    const r = snapPosition({ x: 200, y: 150 }, horiz, vp, false);
+    expect(r).toMatchObject({ x: 200, y: 150, vertical: false, edgeX: null, edgeY: null });
+  });
+
+  it("perto da borda esquerda gruda nela e vira vertical", () => {
+    const r = snapPosition({ x: 20, y: 150 }, vert, vp, false);
+    expect(r).toMatchObject({ x: 8, y: 150, vertical: true, edgeX: "start" });
+  });
+
+  it("perto da borda direita gruda e vira vertical", () => {
+    const r = snapPosition({ x: 1000 - 60 - 8 - 10, y: 150 }, vert, vp, false);
+    expect(r).toMatchObject({ x: 1000 - 60 - 8, vertical: true, edgeX: "end" });
+  });
+
+  it("perto de cima/embaixo gruda e vira horizontal", () => {
+    expect(snapPosition({ x: 200, y: 14 }, horiz, vp, true)).toMatchObject({ y: 8, vertical: false, edgeY: "start" });
+    expect(snapPosition({ x: 200, y: 700 - 60 - 8 - 12 }, horiz, vp, true)).toMatchObject({ y: 700 - 60 - 8, vertical: false, edgeY: "end" });
+  });
+
+  it("num canto (duas bordas) mantém a orientação que tinha", () => {
+    expect(snapPosition({ x: 10, y: 10 }, horiz, vp, false)).toMatchObject({ x: 8, y: 8, vertical: false });
+    expect(snapPosition({ x: 10, y: 10 }, vert, vp, true)).toMatchObject({ x: 8, y: 8, vertical: true });
+  });
+
+  it("o centro da tela também atrai (barra centralizada)", () => {
+    const r = snapPosition({ x: (1000 - 300) / 2 + 9, y: 300 }, horiz, vp, false);
+    expect(r.x).toBe(350);
+    expect(r.edgeX).toBe("center");
+    expect(r.vertical).toBe(false); // centro não muda orientação
+  });
+
+  it("fora do alcance do ímã não gruda", () => {
+    expect(snapPosition({ x: 60, y: 150 }, horiz, vp, false).edgeX).toBeNull();
+  });
+
+  it("soltar fora da tela sempre acaba dentro dela", () => {
+    const r = snapPosition({ x: -500, y: 5000 }, horiz, vp, false);
+    expect(r.x).toBeGreaterThanOrEqual(8);
+    expect(r.y).toBeLessThanOrEqual(700 - 60 - 8);
+    expect(r.x + 300).toBeLessThanOrEqual(1000);
+  });
+
+  it("a barra de páginas aberta (insetLeft) reserva espaço: o ímã da esquerda cola depois dela", () => {
+    expect(snapPosition({ x: 250, y: 150 }, vert, vp, false, { insetLeft: 256 })).toMatchObject({ x: 264, vertical: true, edgeX: "start" });
+  });
+
+  it("janela minúscula (bloco não cabe) não gera posição negativa nem NaN", () => {
+    const r = snapPosition({ x: 50, y: 50 }, { w: 800, h: 900 }, { w: 400, h: 300 }, false);
+    expect(Number.isFinite(r.x) && Number.isFinite(r.y)).toBe(true);
+    expect(r.x).toBeGreaterThanOrEqual(8);
+    expect(r.y).toBeGreaterThanOrEqual(8);
+  });
+});
