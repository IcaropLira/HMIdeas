-  // Fecha o painel ao tocar fora (inclusive no canvas).
+  // Fecha o painel ao tocar fora (inclusive no canvas e nas faixas vazias ao lado do painel).
   useEffect(() => {
     if (!panel) return;
     const close = (e: PointerEvent) => {
-      if (!dockRef.current?.contains(e.target as Node)) setPanel(null);
+      if (!isInsideDock(e.target as Node | null, dockRef.current)) setPanel(null);
     };
     const esc = (e: KeyboardEvent) => e.key === "Escape" && setPanel(null);
     document.addEventListener("pointerdown", close, true);
diff --git a/src/core/outside.test.ts b/src/core/outside.test.ts
new file mode 100644
index 0000000..b0ff788
--- /dev/null
+++ b/src/core/outside.test.ts
@@ -0,0 +1,27 @@
+import { describe, expect, it } from "vitest";
+import { isInsideDock } from "./outside";
+
+const node = (name: string) => ({ name }) as unknown as Node;
+
+describe("isInsideDock", () => {
+  const panelBtn = node("botão dentro do painel");
+  const outside = node("canvas");
+  const dock = { contains: (n: Node) => n === panelBtn || (n as unknown) === dock };
+
+  it("clicar num elemento dentro do dock é 'dentro'", () => {
+    expect(isInsideDock(panelBtn, dock)).toBe(true);
+  });
+
+  it("clicar no canvas (fora do dock) é 'fora'", () => {
+    expect(isInsideDock(outside, dock)).toBe(false);
+  });
+
+  it("clicar no espaço vazio do próprio dock (ao lado do painel) é 'fora', mesmo o dock se contendo", () => {
+    expect(isInsideDock(dock as unknown as Node, dock)).toBe(false);
+  });
+
+  it("sem alvo ou sem dock montado conta como 'fora'", () => {
+    expect(isInsideDock(null, dock)).toBe(false);
+    expect(isInsideDock(panelBtn, null)).toBe(false);
+  });
+});
diff --git a/src/core/outside.ts b/src/core/outside.ts
new file mode 100644
index 0000000..b4de999
--- /dev/null
+++ b/src/core/outside.ts
@@ -0,0 +1,11 @@
+// "Clicar fora" de um painel: o alvo está DENTRO de verdade (num painel/botão) ou só no espaço vazio do contêiner?
+// O `.dock` ocupa a largura da barra de ferramentas, bem mais larga que o painel; as faixas vazias ao lado
+// do painel pertencem ao `.dock` mas não são parte da interface, então clicar nelas tem que fechar o painel.
+
+type Container = { contains(node: Node): boolean };
+
+export function isInsideDock(target: Node | null, dock: Container | null): boolean {
+  if (!target || !dock) return false;
+  if ((target as unknown) === dock) return false; // espaço vazio do próprio contêiner
+  return dock.contains(target);
+}
