diff --git a/src/core/webgl.test.ts b/src/core/webgl.test.ts
new file mode 100644
index 0000000..149e06d
--- /dev/null
+++ b/src/core/webgl.test.ts
@@ -0,0 +1,25 @@
+import { describe, expect, it, vi } from "vitest";
+import { detectWebGL } from "./webgl";
+
+describe("detectWebGL", () => {
+  it("é verdadeiro com WebGL2 e devolve o contexto ao navegador", () => {
+    const loseContext = vi.fn();
+    const gl = { getExtension: () => ({ loseContext }) };
+    expect(detectWebGL(() => ({ getContext: (id) => (id === "webgl2" ? gl : null) }))).toBe(true);
+    expect(loseContext).toHaveBeenCalled();
+  });
+
+  it("cai para WebGL1 quando não há WebGL2", () => {
+    const gl = { getExtension: () => null };
+    expect(detectWebGL(() => ({ getContext: (id) => (id === "webgl" ? gl : null) }))).toBe(true);
+  });
+
+  it("é falso quando o navegador não cria contexto (aceleração desligada)", () => {
+    expect(detectWebGL(() => ({ getContext: () => null }))).toBe(false);
+  });
+
+  it("é falso (e não quebra) se criar o canvas ou o contexto lançar erro", () => {
+    expect(detectWebGL(() => { throw new Error("sem canvas"); })).toBe(false);
+    expect(detectWebGL(() => ({ getContext: () => { throw new Error("bloqueado"); } }))).toBe(false);
+  });
+});
diff --git a/src/core/webgl.ts b/src/core/webgl.ts
new file mode 100644
index 0000000..7cd7b25
--- /dev/null
+++ b/src/core/webgl.ts
@@ -0,0 +1,26 @@
+// O desenho (PixiJS) precisa de WebGL. Sem ele o quadro ficaria em branco sem explicação:
+// aqui detectamos isso e guardamos o motivo para a UI mostrar um aviso (components/WebGLNotice.tsx).
+import { create } from "zustand";
+
+export type GfxProblem = "no-webgl" | "init-failed";
+
+export const useGfx = create<{ problem: GfxProblem | null }>(() => ({ problem: null }));
+
+type Probe = { getContext: (id: string) => unknown };
+
+/**
+ * O navegador consegue criar um contexto WebGL? Testa num canvas descartável (o canvas real só pode
+ * receber um contexto) e pede o mesmo que o Pixi: WebGL2 e, se não houver, WebGL1.
+ * WebGL por software conta como disponível: o que importa é o app conseguir desenhar.
+ */
+export function detectWebGL(make: () => Probe = () => document.createElement("canvas") as unknown as Probe): boolean {
+  try {
+    const canvas = make();
+    const gl = (canvas.getContext("webgl2") ?? canvas.getContext("webgl")) as WebGLRenderingContext | null;
+    if (!gl) return false;
+    gl.getExtension("WEBGL_lose_context")?.loseContext(); // devolve o contexto (o navegador limita quantos existem)
+    return true;
+  } catch {
+    return false;
+  }
+}
