O site (Vercel e GitHub Pages) lê a versão do package.json da main, que ficou em 0.3.2
porque as tags v0.3.3 a v0.3.5 foram criadas sem o commit de versão. O workflow Release
só ajusta a versão dentro da máquina de build e nunca grava de volta na main.
---
 package.json              | 2 +-
 src-tauri/Cargo.toml      | 2 +-
 src-tauri/tauri.conf.json | 2 +-
 3 files changed, 3 insertions(+), 3 deletions(-)

diff --git a/package.json b/package.json
index 8d7edfa..b97f6d5 100644
--- a/package.json
+++ b/package.json
@@ -1,7 +1,7 @@
 {
   "name": "hm-ideas",
   "private": true,
-  "version": "0.3.2",
+  "version": "0.3.5",
   "type": "module",
   "scripts": {
     "dev": "vite",
diff --git a/src-tauri/Cargo.toml b/src-tauri/Cargo.toml
index 82f5d33..65c0f38 100644
--- a/src-tauri/Cargo.toml
+++ b/src-tauri/Cargo.toml
@@ -1,6 +1,6 @@
 [package]
 name = "hm-ideas"
-version = "0.3.2"
+version = "0.3.5"
 description = "HM Ideas (Hiraku Manager Ideas): quadro branco e caderno de anotações com caneta"
 edition = "2021"
 
diff --git a/src-tauri/tauri.conf.json b/src-tauri/tauri.conf.json
index c1006f0..594fee1 100644
--- a/src-tauri/tauri.conf.json
+++ b/src-tauri/tauri.conf.json
@@ -1,7 +1,7 @@
 {
   "$schema": "https://schema.tauri.app/config/2",
   "productName": "HM Ideas",
-  "version": "0.3.2",
+  "version": "0.3.5",
   "identifier": "app.hiraku.hmideas",
   "build": {
     "beforeDevCommand": "npm run dev",
-- 
