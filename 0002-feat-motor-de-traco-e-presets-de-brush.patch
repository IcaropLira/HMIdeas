+        brush: data.brush as BrushKind,
+        width: numberIn("width", 1, 40, t.width),
+        pressureSens: numberIn("pressureSens", 0, 1, t.pressureSens),
+        taper: numberIn("taper", 0, 1, t.taper),
+        brushOpacity: numberIn("opacity", 0.05, 1, t.brushOpacity),
+        smoothing: numberIn("smoothing", 0, 0.9, t.smoothing),
