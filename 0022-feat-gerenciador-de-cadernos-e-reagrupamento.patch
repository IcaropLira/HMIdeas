   Added, Measure, NodePatch, NODE_PRESETS, addChild, addSibling, ancestorsOf, childrenMap, detachToRoot, focusBranch, isNodeEl,
@@ -252,10 +252,23 @@ export function wrapSelectionInFrame() {
 
 export function ungroupSelection() {
   const ids = selIds();
-  let out = els();
+  const before = els();
+  // Guarda os membros ANTES de remover os quadros. A seleção anterior continha apenas
+  // o id do quadro; depois do ungroup esse id deixa de existir e a seleção ficava vazia.
+  // Selecionar os membros permite movê-los juntos e agrupá-los novamente imediatamente.
+  const members = new Set<ID>();
+  for (const id of ids) {
+    const frame = before.find((e) => e.id === id);
+    if (frame?.type === "frame") {
+      // Só os filhos diretos: quadros internos continuam contendo seus próprios elementos.
+      for (const member of before) if (member.frameId === id) members.add(member.id);
+    }
+  }
+  let out = before;
   for (const id of ids) out = ungroupFrame(out, id);
   commit(out);
-  useSel.getState().set(ids.filter((id) => !framesOf(els()).some((f) => f.id === id)));
+  const remaining = new Set(out.map((e) => e.id));
+  useSel.getState().set([...members].filter((id) => remaining.has(id)));
 }
 
 export function fitFrameSelection() {
