diff --git a/scripts/android-keystore.mjs b/scripts/android-keystore.mjs
new file mode 100644
index 0000000..3a2c0cf
--- /dev/null
+++ b/scripts/android-keystore.mjs
@@ -0,0 +1,32 @@
+#!/usr/bin/env node
+// Gera a chave que ASSINA o APK. Use SEMPRE a mesma: o Android só atualiza por cima um app assinado pela mesma chave.
+//   npm run android:keystore
+// Requer o `keytool` (vem com o JDK). O arquivo fica em ~/.tauri/hm-ideas.jks (NUNCA vai para o git).
+import { spawnSync } from "node:child_process";
+import { existsSync, mkdirSync, readFileSync } from "node:fs";
+import { randomBytes } from "node:crypto";
+import { homedir } from "node:os";
+import { join } from "node:path";
+
+const dir = join(homedir(), ".tauri");
+const jks = join(dir, "hm-ideas.jks");
+mkdirSync(dir, { recursive: true });
+if (existsSync(jks)) { console.error(`✖ Já existe ${jks}. Apague só se quiser TROCAR a chave (aí o Android exige desinstalar o app antigo).`); process.exit(1); }
+
+const pass = randomBytes(18).toString("base64url");
+const r = spawnSync("keytool", ["-genkeypair", "-v", "-keystore", jks, "-alias", "hmideas", "-keyalg", "RSA", "-keysize", "2048", "-validity", "36500",
+  "-storepass", pass, "-keypass", pass, "-dname", "CN=HM Ideas, O=HM Ideas, C=BR"], { stdio: "inherit" });
+if (r.status !== 0) { console.error("✖ keytool falhou (instale um JDK)."); process.exit(1); }
+
+console.log(`
+✔ Keystore: ${jks}
+
+No GitHub: Settings → Secrets and variables → Actions → New repository secret
+  ANDROID_KEYSTORE_BASE64    = (o texto abaixo, tudo numa linha)
+  ANDROID_KEYSTORE_PASSWORD  = ${pass}
+  ANDROID_KEY_ALIAS          = hmideas
+
+ANDROID_KEYSTORE_BASE64:
+${readFileSync(jks).toString("base64")}
+
+Guarde o arquivo e a senha em lugar seguro.`);
diff --git a/scripts/set-repo.mjs b/scripts/set-repo.mjs
new file mode 100644
index 0000000..9282689
--- /dev/null
+++ b/scripts/set-repo.mjs
@@ -0,0 +1,15 @@
+#!/usr/bin/env node
+// Aponta o atualizador do app para o seu repositório do GitHub (onde ficam as releases).
+//   node scripts/set-repo.mjs dono/repositorio      (o workflow de release faz isso sozinho)
+import { readFileSync, writeFileSync } from "node:fs";
+
+const repo = process.argv[2] ?? process.env.GITHUB_REPOSITORY ?? "";
+if (!/^[\w.-]+\/[\w.-]+$/.test(repo)) {
+  console.error("Uso: node scripts/set-repo.mjs <dono>/<repositório>");
+  process.exit(1);
+}
+const path = "src-tauri/tauri.conf.json";
+const conf = JSON.parse(readFileSync(path, "utf8"));
+conf.plugins.updater.endpoints = [`https://github.com/${repo}/releases/latest/download/latest.json`];
+writeFileSync(path, JSON.stringify(conf, null, 2) + "\n");
+console.log(`Atualizador aponta para github.com/${repo}`);
diff --git a/scripts/updater-keys.mjs b/scripts/updater-keys.mjs
new file mode 100644
index 0000000..6c3af44
--- /dev/null
+++ b/scripts/updater-keys.mjs
@@ -0,0 +1,33 @@
+#!/usr/bin/env node
+// Gera a chave que ASSINA as atualizações (sem ela, o app recusa qualquer atualização).
+//   npm run updater:keys
+// A chave privada fica em ~/.tauri/hm-ideas.key (NUNCA vai para o git); a pública entra no tauri.conf.json.
+// Depois, cadastre a privada nos Secrets do repositório: TAURI_SIGNING_PRIVATE_KEY (e ..._PASSWORD se pôs senha).
+import { spawnSync } from "node:child_process";
+import { existsSync, mkdirSync, readFileSync, writeFileSync } from "node:fs";
+import { homedir } from "node:os";
+import { join } from "node:path";
+
+const dir = join(homedir(), ".tauri");
+const key = join(dir, "hm-ideas.key");
+mkdirSync(dir, { recursive: true });
+if (existsSync(key)) {
+  console.error(`✖ Já existe ${key}. Apague-a só se quiser TROCAR a chave (apps já instalados deixarão de aceitar atualizações).`);
+  process.exit(1);
+}
+const r = spawnSync("npx", ["tauri", "signer", "generate", "-w", key], { stdio: "inherit", shell: process.platform === "win32" });
+if (r.status !== 0) process.exit(r.status ?? 1);
+
+const pub = readFileSync(key + ".pub", "utf8").trim();
+const path = "src-tauri/tauri.conf.json";
+const conf = JSON.parse(readFileSync(path, "utf8"));
+conf.plugins.updater.pubkey = pub;
+writeFileSync(path, JSON.stringify(conf, null, 2) + "\n");
+console.log(`
+✔ Chave pública gravada em ${path} (faça commit).
+✔ Chave privada: ${key}
+
+Agora, no GitHub: Settings → Secrets and variables → Actions → New repository secret
+  TAURI_SIGNING_PRIVATE_KEY            = conteúdo do arquivo ${key}
+  TAURI_SIGNING_PRIVATE_KEY_PASSWORD   = a senha (se você definiu uma)
+Guarde uma cópia da chave privada em lugar seguro: se perder, os apps instalados não aceitam mais atualizações.`);
