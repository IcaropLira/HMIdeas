@@ -0,0 +1,487 @@
+:root {
+  --paper: #edf0f4;
+  --ink: #1b2233;
+  --ink-soft: #5b6478;
+  --indigo: #2f4b8f;
+  --chrome: rgba(255, 255, 255, 0.94);
+  --line: rgba(27, 34, 51, 0.14);
+  --side: 0px; /* largura ocupada pela barra de páginas (o dock se afasta dela) */
+  font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, "Noto Sans", sans-serif;
+  color: var(--ink);
+}
+
+* { box-sizing: border-box; }
+
+html, body, #root {
+  height: 100%;
+  margin: 0;
+  background: var(--paper);
+  overflow: hidden;
+  overscroll-behavior: none;
+  -webkit-user-select: none;
+  user-select: none;
+  -webkit-touch-callout: none;
+}
+
+.canvas-host { position: fixed; inset: 0; }
+.canvas { display: block; width: 100%; height: 100%; touch-action: none; cursor: crosshair; }
+.canvas.eraser { cursor: none; }
+.canvas.hand { cursor: grab; }
+.canvas.select { cursor: default; }
+.canvas.pick { cursor: copy; }
+
+/* Barra + painéis: um único bloco fixo embaixo, centralizado. */
+.dock {
+  position: fixed;
+  z-index: 5;
+  /* Se há barras laterais (--railL/--railR, definidas pelo Toolbar), a barra de baixo fica entre elas. */
+  left: calc(50% + (var(--side) + var(--railL, 0px) - var(--railR, 0px)) / 2);
+  bottom: calc(14px + env(safe-area-inset-bottom, 0px));
+  transform: translateX(-50%);
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  gap: 8px;
+  max-width: calc(100vw - var(--side) - var(--railL, 0px) - var(--railR, 0px) - 16px);
+  /* O dock é tão largo quanto a barra; o espaço vazio ao lado do painel não pode bloquear o canvas. */
+  pointer-events: none;
+}
+.dock > * { pointer-events: auto; }
+
+.toolbar, .panel {
+  background: var(--chrome);
+  border: 1px solid var(--line);
+  border-radius: 16px;
+  /* Sem backdrop-filter: borrar o que está por baixo força o navegador a reler o canvas WebGL a cada
+     quadro (lento no WebKitGTK/Android). O fundo já é quase opaco. */
+  box-shadow: 0 6px 24px rgba(27, 34, 51, 0.12);
+}
+
+.toolbar {
+  display: flex;
+  align-items: center;
+  gap: 4px;
+  max-width: 100%;
+  overflow-x: auto;
+  padding: 6px 8px;
+  scrollbar-width: none;
+  -ms-overflow-style: none;
+}
+.toolbar::-webkit-scrollbar {
+  display: none;
+}
+
+.panel {
+  display: flex;
+  flex-direction: column;
+  gap: 12px;
+  width: min(360px, calc(100vw - 16px));
+  padding: 14px;
+}
+
+.row { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; }
+
+.chip {
+  min-height: 40px;
+  padding: 0 14px;
+  border: 1px solid var(--line);
+  border-radius: 999px;
+  background: #fff;
+  color: var(--ink);
+  font: inherit;
+  font-size: 14px;
+  cursor: pointer;
+}
+.chip.on { background: var(--indigo); border-color: var(--indigo); color: #fff; }
+
+.slider {
+  display: grid;
+  grid-template-columns: 1fr auto;
+  gap: 4px 12px;
+  align-items: center;
+  font-size: 14px;
+}
+.slider input { grid-column: 1 / -1; width: 100%; accent-color: var(--indigo); height: 28px; }
+.slider output { color: var(--ink-soft); font-variant-numeric: tabular-nums; }
