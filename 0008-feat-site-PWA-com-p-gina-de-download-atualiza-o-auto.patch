+
+describe("repositório de releases", () => {
+  it("deduz dono/repo do GitHub Pages", () => {
+    expect(releasesRepo({ hostname: "ana.github.io", pathname: "/hm-ideas/download.html" })).toBe("ana/hm-ideas");
+    expect(releasesRepo({ hostname: "ana.github.io", pathname: "/" })).toBe("ana/ana.github.io");
+    expect(releasesRepo({ hostname: "ana.github.io", pathname: "/download.html" })).toBe("ana/ana.github.io");
+    expect(releasesRepo({ hostname: "localhost", pathname: "/" })).toBeNull();
+  });
+});
+
+describe("versões", () => {
+  it("compara x.y.z", () => {
+    expect(compareVersions("0.3.0", "0.2.9")).toBeGreaterThan(0);
+    expect(compareVersions("v1.0.0", "1.0.0")).toBe(0);
+    expect(compareVersions("0.10.0", "0.9.0")).toBeGreaterThan(0);
+    expect(compareVersions("0.2.0", "0.2.1")).toBeLessThan(0);
+  });
+});
+
+describe("arquivos da release", () => {
+  const mk = (name: string) => ({ name, url: "u/" + name, size: 1 });
+  it("separa por sistema e ignora assinaturas/latest.json", () => {
+    const d = classifyAssets([
+      "HM.Ideas_1.0.0_x64-setup.exe", "HM.Ideas_1.0.0_x64-setup.exe.sig", "HM.Ideas_1.0.0_x64_en-US.msi",
+      "HM.Ideas_1.0.0_amd64.AppImage", "HM.Ideas_1.0.0_amd64.deb", "HM.Ideas-1.0.0-1.x86_64.rpm",
+      "HM.Ideas_1.0.0_universal.dmg", "HM.Ideas.app.tar.gz", "HM-Ideas_1.0.0.apk", "latest.json",
+    ].map(mk));
+    expect(d.map((x) => x.platform).sort()).toEqual(["android", "linux", "linux", "linux", "macos", "windows", "windows"]);
+    expect(d.find((x) => x.kind === "exe")!.primary).toBe(true);
+    expect(d.find((x) => x.kind === "msi")!.primary).toBe(false);
+  });
+});
diff --git a/src/core/repo.ts b/src/core/repo.ts
new file mode 100644
index 0000000..d6f1ca4
--- /dev/null
+++ b/src/core/repo.ts
@@ -0,0 +1,75 @@
+// Em qual repositório do GitHub estão as versões (releases)? Usado pela página de download e pelo aviso de atualização.
+// Ordem: variável VITE_GH_REPO (definida no build pelo workflow) → deduzido do endereço do GitHub Pages (dono.github.io/repo).
+
+/** "dono/repositório" ou null se não der para saber. */
+export function releasesRepo(loc: Pick<Location, "hostname" | "pathname"> = window.location): string | null {
+  const env = (import.meta.env.VITE_GH_REPO as string | undefined)?.trim();
+  if (env && /^[\w.-]+\/[\w.-]+$/.test(env)) return env;
+  const m = /^([\w-]+)\.github\.io$/i.exec(loc.hostname);
+  if (!m) return null;
+  const first = loc.pathname.split("/").filter(Boolean)[0];
+  return `${m[1]}/${first && !/\.\w+$/.test(first) ? first : `${m[1]}.github.io`}`;
+}
+
+export const APP_VERSION: string = typeof __APP_VERSION__ === "string" ? __APP_VERSION__ : "0.0.0";
+
+/** Compara versões x.y.z (ignora o sufixo -beta). >0 se a > b. */
+export function compareVersions(a: string, b: string): number {
+  const pa = a.replace(/^v/, "").split("-")[0].split(".").map((n) => parseInt(n, 10) || 0);
+  const pb = b.replace(/^v/, "").split("-")[0].split(".").map((n) => parseInt(n, 10) || 0);
+  for (let i = 0; i < 3; i++) if ((pa[i] ?? 0) !== (pb[i] ?? 0)) return (pa[i] ?? 0) - (pb[i] ?? 0);
+  return 0;
+}
+
+export interface ReleaseAsset { name: string; url: string; size: number }
+export interface Release { version: string; name: string; date: string; page: string; notes: string; assets: ReleaseAsset[] }
+
+/** Última versão publicada no GitHub (null se não houver nenhuma ou se a rede falhar). */
+export async function fetchLatestRelease(repo: string): Promise<Release | null> {
+  try {
+    const r = await fetch(`https://api.github.com/repos/${repo}/releases/latest`, { headers: { Accept: "application/vnd.github+json" } });
+    if (!r.ok) return null;
+    const j = await r.json();
+    return {
+      version: String(j.tag_name ?? "").replace(/^v/, ""),
+      name: String(j.name ?? j.tag_name ?? ""),
+      date: String(j.published_at ?? ""),
+      page: String(j.html_url ?? `https://github.com/${repo}/releases`),
+      notes: String(j.body ?? ""),
+      assets: ((j.assets ?? []) as { name: string; browser_download_url: string; size: number }[]).map((a) => ({ name: a.name, url: a.browser_download_url, size: a.size })),
+    };
+  } catch {
+    return null;
+  }
+}
+
+export type Platform = "windows" | "linux" | "macos" | "android";
+export interface Download { platform: Platform; label: string; kind: string; arch: string; asset: ReleaseAsset; primary: boolean }
+
+/** Separa os arquivos da release por sistema; ignora assinaturas, latest.json e pacotes do atualizador. */
+export function classifyAssets(assets: ReleaseAsset[]): Download[] {
+  const out: Download[] = [];
+  for (const a of assets) {
+    const n = a.name.toLowerCase();
+    const arch = /aarch64|arm64/.test(n) ? "ARM64" : /universal/.test(n) ? "Universal" : /x86_64|x64|amd64/.test(n) ? "64 bits" : "";
+    let d: Omit<Download, "asset" | "arch"> | null = null;
+    if (n.endsWith(".exe")) d = { platform: "windows", label: "Instalador (.exe)", kind: "exe", primary: true };
+    else if (n.endsWith(".msi")) d = { platform: "windows", label: "Pacote MSI", kind: "msi", primary: false };
+    else if (n.endsWith(".appimage")) d = { platform: "linux", label: "AppImage (qualquer distro)", kind: "appimage", primary: true };
+    else if (n.endsWith(".deb")) d = { platform: "linux", label: "Debian / Ubuntu (.deb)", kind: "deb", primary: false };
+    else if (n.endsWith(".rpm")) d = { platform: "linux", label: "Fedora / openSUSE (.rpm)", kind: "rpm", primary: false };
+    else if (n.endsWith(".dmg")) d = { platform: "macos", label: "Imagem de disco (.dmg)", kind: "dmg", primary: true };
+    else if (n.endsWith(".apk")) d = { platform: "android", label: "APK (instalar direto)", kind: "apk", primary: true };
+    if (d) out.push({ ...d, arch, asset: a });
+  }
+  return out;
+}
+
+export function detectPlatform(ua = navigator.userAgent): Platform | "ios" | "other" {
+  if (/android/i.test(ua)) return "android";
+  if (/iphone|ipad|ipod/i.test(ua) || (/macintosh/i.test(ua) && navigator.maxTouchPoints > 1)) return "ios";
+  if (/windows/i.test(ua)) return "windows";
+  if (/mac os x|macintosh/i.test(ua)) return "macos";
+  if (/linux|x11|cros/i.test(ua)) return "linux";
+  return "other";
+}
diff --git a/src/core/updater.ts b/src/core/updater.ts
new file mode 100644
index 0000000..26febbb
--- /dev/null
+++ b/src/core/updater.ts
@@ -0,0 +1,131 @@
+// Atualização automática, nos três ambientes:
+//  • Desktop (Tauri): plugin updater do Tauri — baixa o pacote ASSINADO do GitHub Releases, instala e reinicia.
+//  • Android (Tauri): a loja não é usada; o app compara a versão com a última release e oferece baixar o APK novo.
+//  • Site/PWA: o service worker traz a versão nova; o aviso pede um clique para recarregar (nada recarrega sozinho).
+// O desenho é guardado por core/autosave.ts, então atualizar não perde nada.
+import { create } from "zustand";
+import { APP_VERSION, compareVersions, fetchLatestRelease, releasesRepo } from "./repo";
+import { useUI } from "./ui";
+
+export type UpdateKind = "desktop" | "link" | "pwa";
+export interface UpdateState {
+  status: "idle" | "checking" | "available" | "downloading" | "installing" | "error";
+  kind: UpdateKind | null;
+  version: string | null;
+  notes: string;
+  /** 0..1 durante o download (null = desconhecido). */
+  progress: number | null;
+  /** Para kind "link": endereço do download. */
+  url: string | null;
+  error: string | null;
+  dismissed: boolean;
+}
+
+export const useUpdate = create<UpdateState>(() => ({
+  status: "idle", kind: null, version: null, notes: "", progress: null, url: null, error: null, dismissed: false,
+}));
+const set = (p: Partial<UpdateState>) => useUpdate.setState(p);
+
+export const isTauri = () => typeof window !== "undefined" && "__TAURI_INTERNALS__" in window;
+const isAndroid = () => /android/i.test(navigator.userAgent);
+
+// referência ao objeto de atualização do plugin (tem downloadAndInstall) e à função do service worker
+let desktopUpdate: { version: string; body?: string | null; downloadAndInstall: (cb?: (e: { event: string; data?: { contentLength?: number; chunkLength?: number } }) => void) => Promise<void> } | null = null;
+let applyPwa: ((reload?: boolean) => Promise<void>) | null = null;
+let swRegistration: ServiceWorkerRegistration | undefined;
+
+/** Procura atualização agora. `manual`: avisa também quando não há nada novo. */
+export async function checkForUpdates(manual = false): Promise<void> {
+  const cur = useUpdate.getState();
+  if (cur.status === "checking" || cur.status === "downloading" || cur.status === "installing") return;
+  const toast = (m: string) => manual && useUI.getState().showToast(m);
+  try {
+    if (isTauri() && !isAndroid()) {
+      set({ status: "checking", error: null });
+      const { check } = await import("@tauri-apps/plugin-updater");
+      const u = await check();
+      if (!u) { set({ status: "idle" }); toast(`Você já está na versão mais recente (${APP_VERSION}).`); return; }
+      desktopUpdate = u as unknown as typeof desktopUpdate;
+      set({ status: "available", kind: "desktop", version: u.version, notes: u.body ?? "", dismissed: false });
+    } else if (isTauri()) {
+      set({ status: "checking", error: null });
+      await checkLink(manual);
+    } else if (swRegistration) {
+      set({ status: "checking" });
+      await swRegistration.update(); // se houver versão nova, o registerSW chama onNeedRefresh
+      if (useUpdate.getState().status === "checking") { set({ status: "idle" }); toast(`Você já está na versão mais recente (${APP_VERSION}).`); }
+    }
+  } catch (e) {
+    set({ status: "idle" });
+    if (manual) useUI.getState().showToast("Não consegui verificar atualizações agora.");
+    console.warn("update check failed", e);
+  }
+}
+
+/** Android / Linux .deb: compara com a última release do GitHub. */
+async function checkLink(manual: boolean) {
+  const repo = releasesRepo();
+  const rel = repo ? await fetchLatestRelease(repo) : null;
+  if (!rel || compareVersions(rel.version, APP_VERSION) <= 0) {
+    set({ status: "idle" });
+    if (manual) useUI.getState().showToast(`Você já está na versão mais recente (${APP_VERSION}).`);
+    return;
+  }
+  const apk = rel.assets.find((a) => a.name.toLowerCase().endsWith(".apk"));
+  set({ status: "available", kind: "link", version: rel.version, notes: rel.notes, url: apk?.url ?? rel.page, dismissed: false });
+}
+
+/** Botão "Atualizar" do aviso. */
+export async function installUpdate(): Promise<void> {
+  const s = useUpdate.getState();
+  try {
+    if (s.kind === "desktop" && desktopUpdate) {
+      set({ status: "downloading", progress: null, error: null });
+      let total = 0, got = 0;
+      await desktopUpdate.downloadAndInstall((e) => {
+        if (e.event === "Started") total = e.data?.contentLength ?? 0;
+        else if (e.event === "Progress") { got += e.data?.chunkLength ?? 0; set({ progress: total ? Math.min(1, got / total) : null }); }
+        else if (e.event === "Finished") set({ status: "installing", progress: 1 });
+      });
+      const { relaunch } = await import("@tauri-apps/plugin-process");
+      await relaunch();
+    } else if (s.kind === "link" && s.url) {
+      const { openUrl } = await import("@tauri-apps/plugin-opener");
+      await openUrl(s.url);
+    } else if (s.kind === "pwa" && applyPwa) {
+      set({ status: "installing" });
+      await applyPwa(true);
+    }
+  } catch (e) {
+    // .deb/.rpm não se atualizam sozinhos: cai para a página de download
+    const repo = releasesRepo();
+    set({ status: "available", kind: "link", url: repo ? `https://github.com/${repo}/releases/latest` : null, error: e instanceof Error ? e.message : String(e) });
+  }
+}
+
+export const dismissUpdate = () => set({ dismissed: true });
+
+const SIX_HOURS = 6 * 3600 * 1000;
+
+/** Liga a verificação automática (ao abrir e a cada 6 h). Devolve a função que desliga. */
+export function initUpdates(): () => void {
+  let timer: ReturnType<typeof setInterval> | undefined;
+  let first: ReturnType<typeof setTimeout> | undefined;
+  let off = false;
+
+  if (isTauri()) {
+    first = setTimeout(() => void checkForUpdates(), 8000); // não disputa com a abertura do app
+    timer = setInterval(() => void checkForUpdates(), SIX_HOURS);
+  } else if ("serviceWorker" in navigator) {
+    void import("virtual:pwa-register").then(({ registerSW }) => {
+      if (off) return;
+      applyPwa = registerSW({
+        immediate: true,
+        onNeedRefresh() { set({ status: "available", kind: "pwa", version: null, dismissed: false }); },
+        onRegisteredSW(_url, reg) { swRegistration = reg; },
+      });
+      timer = setInterval(() => void swRegistration?.update(), SIX_HOURS / 6);
+    }).catch(() => undefined);
+  }
+  return () => { off = true; clearTimeout(first); clearInterval(timer); };
+}
