 /** Contorno do traço como lista plana [x0, y0, x1, y1, ...]. */
 export function strokeOutline(points: InkPoint[], st: InkStyle, last: boolean): number[] {
   // Caneta real varia a pressão; mouse/dedo ficam sempre em 0.5.
   const simulate = !points.some((p) => p.p !== 0.5);
+  const brush = st.brush ?? "ink";
   const taper = st.taper * st.width * 6;
+  const profile = {
+    pencil: { thinning: 0.62, smoothing: 0.58, streamline: 0.22 },
+    ink: { thinning: 0.32, smoothing: 0.72, streamline: 0.28 },
+    marker: { thinning: 0.12, smoothing: 0.68, streamline: 0.2 },
+    highlighter: { thinning: 0.02, smoothing: 0.72, streamline: 0.18 },
+    charcoal: { thinning: 0.82, smoothing: 0.38, streamline: 0.12 },
+    soft: { thinning: 0.24, smoothing: 0.88, streamline: 0.3 },
+  }[brush];
   const outline = getStroke(
     points.map((p) => [p.x, p.y, p.p]),
     {
       size: st.width,
-      thinning: (simulate ? 0.5 : 0.8) * st.sens,
